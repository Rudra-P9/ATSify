{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Scan": {
      "title": "Scan",
      "description": "Resume scan results",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resumeText": { "type": "string" },
        "jobDescription": { "type": "string" },
        "results": {
          "type": "array",
          "items": { "type": "object" }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "wordCount": { "type": "number" },
            "sections": { "type": "array", "items": { "type": "string" } },
            "skills": { "type": "array", "items": { "type": "string" } },
            "positions": { "type": "number" },
            "education": { "type": "array", "items": { "type": "string" } },
            "contactInfo": { "type": "object" },
            "checkmarks": { "type": "object" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "resumeText", "results", "metadata", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/scans/{scanId}": {
      "schema": "Scan",
      "description": "Resume scans"
    }
  }
}
